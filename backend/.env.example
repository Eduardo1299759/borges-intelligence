# Execução local sem Docker. Copie para backend/.env.
BORGES_ENV=development
# Padrão: SQLite local. Para PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/borges
BORGES_DATABASE_URL=sqlite:///./borges.db
# Sem chave em desenvolvimento, uma chave temporária é gerada e as sessões caem a cada reinício.
BORGES_SECRET_KEY=
BORGES_ADMIN_EMAIL=admin@borges.local
# Vazio: o comando seed gera uma senha e a exibe uma única vez.
BORGES_ADMIN_PASSWORD=
# Chave Fernet que cifra credenciais de integrações (Windsor.ai). Obrigatória para conectar fontes reais.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde-a com cuidado: se for perdida ou trocada, as credenciais salvas precisam ser cadastradas de novo.
BORGES_ENCRYPTION_KEY=
