# Copie para .env (usado pelo docker compose). Nunca versione o .env.
# Gere valores com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
BORGES_SECRET_KEY=
# Administrador inicial (criado no primeiro start). Troque a senha.
BORGES_ADMIN_EMAIL=admin@borges.local
BORGES_ADMIN_PASSWORD=
# Chave Fernet que cifra credenciais de integrações. Gere com:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BORGES_ENCRYPTION_KEY=
# Opcional: limita quais contas do Windsor.ai esta instalação pode ver e ler (IDs separados por vírgula).
BORGES_WINDSOR_ALLOWED_ACCOUNTS=
